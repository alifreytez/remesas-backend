# ==========================================
# BOOST-BACKEND / REMESAS - ENTORNO DE DESARROLLO
# ==========================================

# ------------------------------------------
# SERVIDOR Y APLICACIÓN
# ------------------------------------------
APP_ENV=development
API_HOST=127.0.0.1
PORT=3000
SECURE_PROTOCOL=false
DOMAIN=localhost

# ------------------------------------------
# CARACTERÍSTICAS
# ------------------------------------------
ENABLE_CORS=true
ENABLE_HELMET=true
ENABLE_MORGAN=true
ENABLE_DATABASE=true
ENABLE_DOCS=true
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ------------------------------------------
# SEGURIDAD Y JWT
# ------------------------------------------
JWT_SECRET=super-secret-key-REMESAS-access
JWT_REFRESH_SECRET=super-secret-key-REMESAS-refresh
JWT_COMMON_SECRET=REMESAS-common-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
JWT_COOKIE_ACCESS_NAME=AT
JWT_COOKIE_REFRESH_NAME=RT
BCRYPT_ROUNDS=10
AUTH_RESET_CODE_EXPIRES_IN=30m
AUTH_RESET_TOKEN_EXPIRES_IN=1h

# ------------------------------------------
# BASE DE DATOS (POSTGRESQL)
# ------------------------------------------
ENABLED_DATABASES=postgresql
DEFAULT_DATABASE=postgresql

DB_POSTGRESQL_MAIN_ENABLED=true
DB_POSTGRESQL_MAIN_DIALECT=postgres
DB_POSTGRESQL_MAIN_HOST=127.0.0.1
DB_POSTGRESQL_MAIN_PORT=5432
DB_POSTGRESQL_MAIN_DATABASE=REMESAS
DB_POSTGRESQL_MAIN_USERNAME=postgres
DB_POSTGRESQL_MAIN_PASSWORD=postgres
DB_POSTGRESQL_MAIN_LOGGING=false
DB_POSTGRESQL_MAIN_POOL_MIN=0
DB_POSTGRESQL_MAIN_POOL_MAX=10
DB_POSTGRESQL_MAIN_POOL_IDLE=10000
DB_POSTGRESQL_MAIN_POOL_ACQUIRE=30000
DB_POSTGRESQL_MAIN_SSL=false
DB_POSTGRESQL_MAIN_SYNC_FORCE=false
DB_POSTGRESQL_MAIN_SYNC_ALTER=false
DB_POSTGRESQL_MAIN_TIMEZONE=-04:00

# ------------------------------------------
# CACHÉ (REDIS)
# ------------------------------------------
CACHE_DATABASE_HOST=127.0.0.1
CACHE_DATABASE_PORT=6379
CACHE_DATABASE_USERNAME=
CACHE_DATABASE_PASSWORD=

# ------------------------------------------
# CORREO Y SMTP (NODEMAILER)
# ------------------------------------------
# Credenciales del correo del sistema (por ejemplo, para notificaciones de autenticación).
# Nota: Estas credenciales no se aplican por defecto al crear nuevos transporters;
# solo se usan donde explícitamente se requieran (ej. auth-email.service.ts).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=dev.REMESAS.test@gmail.com
EMAIL_PASS=tu-clave-de-aplicacion
EMAIL_FROM=dev.REMESAS.test@gmail.com

# En entorno development, el envío de correos se restringe a las siguientes direcciones para evitar spam:
EMAIL_AVAILABLE_FOR_SEND=pastoralirio6589@gmail.com

# ------------------------------------------
# DOCUMENTACIÓN E INTEGRACIONES
# ------------------------------------------
DOCS_PATH=/api-docs
DOCS_TITLE="REMESAS API"
DOCS_DESCRIPTION="Documentación de la API de REMESAS (Sistema de Operaciones Académicas)"


