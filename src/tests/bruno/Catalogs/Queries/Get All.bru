meta {
  name: Get Catalog Items
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/catalogs/{{catalog}}?limit=-1
  body: none
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

params:query {
  limit: -1
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  catalog: permission-resources
}
