meta {
  name: Get Admin Unit Email
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/catalogs/cash-desk-request-types/1/admin-unit/2/email
  body: none
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
