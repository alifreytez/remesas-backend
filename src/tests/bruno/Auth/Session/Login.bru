meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

body:json {
  {
    "username": "admin",
    "password": "Password123*"
  }
}
script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.tokens) {
      bru.setEnvVar("accessToken", data.data.tokens.accessToken);
      bru.setEnvVar("refreshToken", data.data.tokens.refreshToken);
    }
  }
}
