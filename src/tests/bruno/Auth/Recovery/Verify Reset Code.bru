meta {
  name: Verify Reset Code
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/verify-reset-code
  body: json
  auth: none
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

body:json {
  {
    "username": "admin",
    "code": "123456"
  }
}
script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data.data && data.data.resetToken) {
      bru.setEnvVar("resetToken", data.data.resetToken);
    }
  }
}
