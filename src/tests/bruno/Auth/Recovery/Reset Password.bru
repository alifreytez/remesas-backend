meta {
  name: Reset Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/reset-password
  body: json
  auth: none
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

body:json {
  {
    "username": "admin",
    "token": "{{resetToken}}",
    "password": "NewPassword123*"
  }
}
