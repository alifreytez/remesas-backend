meta {
  name: Delete User Permissions
  type: http
  seq: 16
}

delete {
  url: {{baseUrl}}/users/{{testUserId}}/permissions/{{testPermissionId}}
  body: none
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  testUserId: 2
  testPermissionId: 53
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
