meta {
  name: Assign User Roles
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/users/{{testUserId}}/roles
  body: json
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "roles": [{{testRoleId}}]
  }
}

vars:pre-request {
  testUserId: 1
  testRoleId: 4
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
