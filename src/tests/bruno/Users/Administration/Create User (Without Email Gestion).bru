meta {
  name: Create User (Without Email Gestion)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "usuario": "nuevo_usr_02",
    "clave": "NoCorreo2026**",
    "unidadAdministradora": 1,
    "empleadoResponsable": 1,
    "roles": [1]
  }
}

tests {
  test("Should successfully create a user without requiring email_gestion", function() {
    const resBody = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(resBody.data.usuario).to.equal("nuevo_usr_02");
    expect(resBody.data.emailGestion).to.be.undefined; // or null depending on database serialization when omitted
  });
}
