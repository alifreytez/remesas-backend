meta {
  name: Create User (With Email Gestion)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "usuario": "nuevo_usr_01",
    "clave": "ClaveSegura2026**",
    "emailGestion": "admin.coordinador@REMESAS.edu.ve",
    "unidadAdministradora": 1,
    "empleadoResponsable": 1,
    "roles": [1, 2]
  }
}

tests {
  test("Should successfully create a new user account with management email", function() {
    const resBody = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(resBody.data.emailGestion).to.equal("admin.coordinador@REMESAS.edu.ve");
  });
}

