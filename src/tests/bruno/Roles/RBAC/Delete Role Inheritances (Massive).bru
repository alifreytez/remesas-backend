meta {
  name: Delete Role Inheritances (Massive)
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/roles/{{testRoleId}}/inheritances/uninheritances
  body: json
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "herencias": [{{testParentRoleId}}]
  }
}

vars:pre-request {
  testRoleId: 4
  testParentRoleId: 2
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
