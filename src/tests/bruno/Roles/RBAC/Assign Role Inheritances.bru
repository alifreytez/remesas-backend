meta {
  name: Assign Role Inheritances
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/roles/{{testRoleId}}/inheritances
  body: json
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "herencias": [{{testParentRoleId}}]
  }
}

vars:pre-request {
  testRoleId: 2
  testParentRoleId: 3
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
