meta {
  name: Assign Role Permissions
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/roles/{{testRoleId}}/permissions
  body: json
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "permisos": [{{testPermissionId}}]
  }
}

vars:pre-request {
  testRoleId: 1
  testPermissionId: 53
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
