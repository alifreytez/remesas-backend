meta {
  name: Delete Role Inheritance
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/roles/{{testRoleId}}/inheritances/{{testParentRoleId}}
  body: none
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  testRoleId: 2
  testParentRoleId: 3
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
