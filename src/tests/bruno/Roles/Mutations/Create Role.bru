meta {
  name: Create Role
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/roles
  body: json
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "codigo": "ROL_TEST_BRUNO",
    "descripcion": "Rol de prueba generado desde Bruno",
    "permisos": [53]
  }
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
