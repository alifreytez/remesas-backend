meta {
  name: Delete Roles (Massive)
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/roles
  body: json
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "id": [{{testRoleId1}}, {{testRoleId2}}]
  }
}

vars:pre-request {
  testRoleId1: 998
  testRoleId2: 999
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
