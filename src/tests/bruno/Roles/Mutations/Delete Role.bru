meta {
  name: Delete Role
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/roles/{{testRoleId}}
  body: none
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  testRoleId: 5
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
