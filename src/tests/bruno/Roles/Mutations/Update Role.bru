meta {
  name: Update Role
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/roles/{{testRoleId}}
  body: json
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "descripcion": "Rol de prueba modificado desde Bruno",
    "permisos": [53],
    "permisosEliminar": []
  }
}

vars:pre-request {
  testRoleId: 5
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
