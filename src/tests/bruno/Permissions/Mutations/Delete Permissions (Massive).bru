meta {
  name: Delete Permissions (Massive)
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/permissions
  body: json
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "id": [{{testPermId1}}, {{testPermId2}}]
  }
}

vars:pre-request {
  testPermId1: 998
  testPermId2: 999
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
