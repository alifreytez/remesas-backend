meta {
  name: Create Permission
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/permissions
  body: json
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "recurso": 1,
    "accion": 1,
    "tipoPermiso": 1
  }
}

script:pre-request {
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://127.0.0.1:4000/api/v1';
  bru.setVar('baseUrl', baseUrl);
}
