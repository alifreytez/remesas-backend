meta {
  name: Create Commission
  type: http
  seq: 75
}

post {
  url: {{baseUrl}}/finances/commissions
  body: json
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}
body:json {
  {
    "originCountry": 1,
    "fixedAmount": 2.5,
    "percentage": 1.5
  }
}
