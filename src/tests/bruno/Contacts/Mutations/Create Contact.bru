meta {
  name: Create Contact
  type: http
  seq: 65
}

post {
  url: {{baseUrl}}/contacts
  body: json
  auth: bearer
}

headers {
  x-client-channel: web
  x-device-id: bruno-test-device
}

auth:bearer {
  token: {{accessToken}}
}
body:json {
  {
    "client": 1,
    "name": "Maria Gomez",
    "document": "87654321",
    "country": 1,
    "contactData": { "bank": "Banesco", "account": "01340000" }
  }
}
