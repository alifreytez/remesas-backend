{
	"name": "boost-backend",
	"version": "1.0.0",
	"description": "API Restful Unificada",
	"author": "promo69-team & alidev00",
	"license": "UNLICENSED",
	"main": "build/index.js",
	"type": "module",
	"scripts": {
		"build": "cross-env vite build",
		"build:full": "yarn clean && yarn build",
		"start": "node build/index.js",
		"dev": "yarn type-check && vite-node --watch --mode development src/index.ts",
		"dev:simple": "cross-env VITE_NODE_SIMPLE=true vite-node --mode development src/index.ts",
		"dev:inspect": "tsx watch --inspect src/index.ts",
		"clean": "rimraf build",
		"clean:all": "rimraf build node_modules/.cache",
		"lint": "eslint \"src/**/*.{ts,cjs,js}\"",
		"format": "prettier --write \"src/**/*.{ts,cjs,js}\"",
		"type-check": "tsc --noEmit",
		"test:email": "vite-node src/tests/test-email.ts",
		"load-vars": "node load-vars.cjs",
		"db:migrate": "node src/database/cli/scripts/seq-tools.js db:migrate",
		"db:seed:all": "node src/database/cli/scripts/seq-tools.js db:seed:all",
		"db:seed": "node src/database/cli/scripts/seq-tools.js db:seed --seed",
		"db:setup": "node src/database/cli/scripts/seq-tools.js db:create",
		"db:drop": "node src/database/cli/scripts/seq-tools.js db:drop",
		"db": "node src/database/cli/scripts/db-help.js",
		"db:setup:fresh": "yarn db:setup && yarn db:migrate && yarn db:seed:all",
		"db:reset": "yarn db:drop && yarn db:setup",
		"db:reset:fresh": "yarn db:reset && yarn db:migrate && yarn db:seed:all",
		"db:backup": "node src/database/cli/scripts/pg-tools.js backup",
		"db:restore": "node src/database/cli/scripts/pg-tools.js restore",
		"db:export-data": "node src/database/cli/scripts/pg-tools.js export-data",
		"db:import-data": "node src/database/cli/scripts/pg-tools.js import-data",
		"db:export-schema": "node src/database/cli/scripts/pg-tools.js export-schema",
		"docker:exec": "docker compose -f docker-compose.yml exec",
		"docker:api-exec": "yarn docker:exec api",
		"docker:build": "docker compose -f docker-compose.yml up -d --build",
		"docker:up": "docker compose -f docker-compose.yml up -d",
		"docker:down": "docker compose -f docker-compose.yml down",
		"docker:down:volumes": "docker compose -f docker-compose.yml down -v",
		"docker:down:hard": "docker compose -f docker-compose.yml down -v --rmi local",
		"docker:logs": "docker compose -f docker-compose.yml logs -f",
		"docker:reset": "docker compose -f docker-compose.yml down -v --rmi local && docker compose -f docker-compose.yml up -d --build",
		"docker:reset:full": "docker compose -f docker-compose.yml down -v --rmi local && docker compose -f docker-compose.yml up -d --build && node -e \"setTimeout(()=>console.log('Esperando a PostgreSQL...'), 10000)\" && yarn docker:api-exec yarn db:reset:fresh",
		"docker:restart": "yarn docker:down && yarn docker:up",
		"docker:clear-cache": "yarn docker:exec redis redis-cli FLUSHALL"
	},
	"devDependencies": {
		"@apidevtools/swagger-parser": "^12.1.0",
		"@types/bcryptjs": "^3.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/helmet": "^4.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/multer": "^2.0.0",
		"@types/node": "^25.0.3",
		"@types/pdfkit": "^0.17.6",
		"@types/pdfmake": "^0.3.3",
		"@types/qrcode": "^1.5.6",
		"@types/supertest": "^7.2.0",
		"@types/swagger-ui-express": "^4.1.8",
		"@types/yamljs": "^0.2.34",
		"@typescript-eslint/eslint-plugin": "^8.50.0",
		"@typescript-eslint/parser": "^8.50.0",
		"axios": "^1.19.0",
		"cross-env": "^10.1.0",
		"esbuild-plugin-tsconfig-paths": "^1.0.2",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.0.2",
		"nodemon": "^3.1.14",
		"prettier": "^3.5.2",
		"rimraf": "^6.1.3",
		"supertest": "^7.2.2",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^8.0.1",
		"vite-node": "^6.0.0"
	},
	"dependencies": {
		"@google/generative-ai": "^0.24.1",
		"@socket.io/redis-adapter": "^8.3.0",
		"@types/cheerio": "^1.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/nodemailer": "^7.0.4",
		"@types/sequelize": "^6.12.0",
		"bcrypt": "^6.0.0",
		"bcryptjs": "^3.0.3",
		"bullmq": "^5.77.0",
		"cheerio": "^1.2.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"dotenv": "^17.2.3",
		"exceljs": "^4.4.0",
		"express": "^5.2.1",
		"googleapis": "^171.4.0",
		"helmet": "^8.1.0",
		"imagekit": "^6.0.0",
		"ioredis": "^5.10.1",
		"joi": "^18.0.2",
		"jsonwebtoken": "^9.0.3",
		"mime-types": "^3.0.2",
		"morgan": "^1.10.1",
		"multer": "^2.0.2",
		"nanoid": "^5.1.7",
		"nodemailer": "^7.0.12",
		"pdfkit": "^0.19.0",
		"pdfmake": "^0.3.11",
		"pg": "^8.16.3",
		"qrcode": "^1.5.4",
		"sequelize": "^6.37.7",
		"sequelize-cli": "^6.6.5",
		"socket.io": "^4.8.3",
		"swagger-ui-express": "^5.0.1",
		"yamljs": "^0.3.0"
	}
}
